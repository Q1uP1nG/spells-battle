# Public DNS name whose A/AAAA record points to the Alibaba Cloud ECS instance.
SPELLS_DOMAIN=duel.example.com

SPELLS_SERVER_TICK_RATE=30
SPELLS_SERVER_SNAPSHOT_RATE=15
SPELLS_SERVER_RECONNECT_TIMEOUT=45
SPELLS_SERVER_ROOM_IDLE_TIMEOUT=900
SPELLS_SERVER_LOG_LEVEL=INFO

# Set this on each Windows client (not consumed by Docker Compose):
# SPELLS_SERVER_URL=wss://duel.example.com
